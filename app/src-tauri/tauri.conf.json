{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BrisaSync",
  "version": "1.1.0",
  "identifier": "app.brisasync.BrisaSync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BrisaSync",
        "width": 1180,
        "height": 788,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#f5f6fa"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "shortDescription": "Sincronize Google Drive, OneDrive, Dropbox e Nextcloud",
    "longDescription": "BrisaSync mantém pastas deste computador em sincronização bidirecional com Google Drive, OneDrive, Dropbox e Nextcloud, com o motor bisync do rclone embutido.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "libayatana-appindicator3-1"
        ],
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/doc/brisasync/copyright": "../../LICENSE"
        },
        "desktopTemplate": "deb/brisasync.desktop",
        "replaces": [
          "nuvem (<< 1.3.0)"
        ],
        "conflicts": [
          "nuvem (<< 1.3.0)"
        ],
        "provides": [
          "nuvem"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMDlGQkJDQjM3RDNBQTQKUldTa09uMnp2UHNKWWdhb1crWUpJU2RiU2JjejMyeTdaNlZCRFpZVkRSU2p3eE9GUmtOM3dFZTQK",
      "endpoints": [
        "https://github.com/fabio-agreles/BrisaSync/releases/latest/download/latest.json"
      ]
    }
  }
}
