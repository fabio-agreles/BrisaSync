[Unit]
Description=BrisaSync — Servico de Sincronizacao Bidirecional da Sessao do Usuario
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/brisasync --service
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target

